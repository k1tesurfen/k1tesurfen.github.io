---
const { title = "Portfolio" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <style is:global>
      @font-face {
        font-family: 'Geist Mono';
        src: url('/fonts/GeistMono[wght].woff2') format('woff2-variations');
        font-weight: 100 900; /* This tells the browser it's a variable range */
        font-display: swap;
        font-style: normal;
      }
      @font-face{
        font-family: 'Stalinist One';
        src: url('/fonts/stalinist-one-v58-latin-regular.woff2') format('woff2');
      }

      :root {
        --font-mono: 'Geist Mono', monospace;
        --font-headline: 'Stalinist One';
        --color-dark: #161616;
        --color-light: oklch(0.9814 0.02 64.9);
      }
      body {
        font-family: var(--font-mono);
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: var(--color-dark);
        color: var(--color-light);
      }
      body::before{
        content: "";
        background-image: url(https://upload.wikimedia.org/wikipedia/commons/5/5c/Image_gaussian_noise_example.png);
        position: fixed;
        width: 100%;
        height: 100vh;
        top: 0;
        opacity: 0.1;
        pointer-events: none;
      }

      main {
        display: grid;
        gap: 2rem;
        height:100vh;
      }
      footer{
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 1rem;
      }
      footer a{
        color: var(--color-light);
      }
      footer a:visited{
        color: var(--color-light);
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2026 kaith.de</p>
      <nav>
        <a href="/imprint">Imprint</a>
      </nav>
    </footer>
  </body>
</html>
