
---
interface Props {
  svgCode?: string;
  headline?: string;
  text?: string;
  linkHref?: string;
  linkLabel?: string;
}

const {
  svgCode,
  headline,
  text,
  linkHref,
  linkLabel = "Learn more",
} = Astro.props;
---
<style>
  .card {
    background: transparent;
    padding: 0;
    border-radius: 0.3rem;
    width: 20rem;
    height: fit-content;
    text-align: center;
    border: 2px solid var(--color-light);
    align-self: center;
  }

  .icon-wrapper{
    width: 69%;
    border-radius: 0.75rem;
    margin: 1rem auto;
  }


  h2 {
    font-family: var(--font-mono);
    margin-bottom:1rem;
    padding: 0 1rem;
    font-size: 1.1rem;
    border-top: 2px solid var(--color-light);
    border-bottom: 2px solid var(--color-light);
  }

  p {
    padding-left:1.6rem;
    padding-right:1.6rem;
    font-size: 0.86rem;
    line-height: 1.5;
    opacity: 0.8;
    margin-bottom: 1rem;
  }

  a.button {
    display: flex;
    flex-grow:1;
    justify-content: center;
    margin:0 1rem 1rem 1rem;
    padding: 0.5rem 1rem;
    background: var(--color-light);
    color: var(--color-dark);
    border-radius: 0.2rem;
    text-decoration: none;
    font-weight: 500;
  }
</style>

<div class="card">
  {svgCode && (
    <div class="icon-wrapper" set:html={svgCode} />
  )}

  {headline && <h2>{headline}</h2>}

  {text && <p set:html={text} />}

  {linkHref && (
    <a class="button" href={linkHref}>
      {linkLabel}
    </a>
  )}
</div>
